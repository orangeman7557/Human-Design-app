/**
 * Cloudflare Workers deployment configuration.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * This project is a SvelteKit SPA. The build is produced by
 * @sveltejs/adapter-cloudflare into `.svelte-kit/cloudflare/`,
 * which contains both the Worker entry point and the static assets.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "human-design-chart-app",
  "compatibility_date": "2025-05-15",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": {
    "enabled": true
  }
  // Global "send love" counter (About modal → /api/love). Uncomment once the
  // KV namespace exists (Cloudflare dashboard → Storage & Databases → KV →
  // create namespace, e.g. "hd-love") and paste its id below. Until then the
  // endpoint degrades gracefully and the counter is hidden in the UI.
  // ,"kv_namespaces": [
  //   { "binding": "LOVE", "id": "PASTE_NAMESPACE_ID_HERE" }
  // ]
}
